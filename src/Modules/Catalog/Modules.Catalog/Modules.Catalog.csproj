<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>FSH.Modules.Catalog</RootNamespace>
		<AssemblyName>FSH.Modules.Catalog</AssemblyName>
		<PackageId>FullStackHero.Modules.Catalog</PackageId>
		<!-- CA1308: slugs/segments are canonical lowercase (URL-friendly per spec §7).
		     CA1711: CatalogAttribute / ProductAttribute are domain entity names from
		     the spec (§2.5, §2.12) — they are product attributes, not .NET attributes. -->
		<NoWarn>$(NoWarn);CA1031;CA1812;CA1859;S3267;CA1308;CA1711;CA1873;CA1860</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Data\Seeds\google-taxonomy.es-ES.txt" />
		<EmbeddedResource Include="Data\Seeds\google-taxonomy.es-ES.txt" WithCulture="false">
			<LogicalName>google-taxonomy.es-ES.txt</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\BuildingBlocks\Persistence\Persistence.csproj" />
		<ProjectReference Include="..\..\..\BuildingBlocks\Web\Web.csproj" />
		<ProjectReference Include="..\Modules.Catalog.Contracts\Modules.Catalog.Contracts.csproj" />
		<!-- Files.Contracts: product/brand/category images register IFileAccessPolicy. -->
		<ProjectReference Include="..\..\Files\Modules.Files.Contracts\Modules.Files.Contracts.csproj" />
	</ItemGroup>

</Project>
